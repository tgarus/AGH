# Copy to /etc/asi/asi-worker.env with chmod 0600 owned by root:asi-worker
ASI_WORKER_API_URL=https://asi.agh.edu.pl
ASI_WORKER_NAME=agh-segment-a-01
ASI_WORKER_SEGMENT_TAG=core-campus
ASI_WORKER_TOKEN=replace-with-generated-worker-token
ASI_WORKER_MAX_CONCURRENCY=4
ASI_KILL_GRACE_SECONDS=3
ASI_ALLOW_LOCAL_MOCK_LAB=false
ASI_LOG_FORMAT=json
